@model Mission06_Morgan.Models.Movie

@{
    ViewData["Title"] = "Fill out the Movie Form";
}

<div class="cardish cardish--narrow">
    <h1 class="mb-2">@ViewData["Title"]</h1>
    <p class="text-muted mb-4 text-center">Add a movie to the collection.</p>

    <form asp-action="movieForm" method="post" class="movie-form">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label">Category</label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">Select a category</option>
                    @foreach (var c in ViewBag.Categories)
                    {
                        <option value="@c.CategoryId">@c.CategoryName</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>

            </div>

            <div class="col-md-6">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="Movie title" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Year" class="form-label"></label>
                <input asp-for="Year" class="form-control" placeholder="e.g. 2015" />
                <span asp-validation-for="Year" class="text-danger small"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="Director" class="form-label"></label>
                <input asp-for="Director" class="form-control" placeholder="Director name" />
                <span asp-validation-for="Director" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Rating" class="form-label"></label>
                <select asp-for="Rating" class="form-select">
                    <option value="">Select a rating</option>
                    <option value="G">G</option>
                    <option value="PG">PG</option>
                    <option value="PG-13">PG-13</option>
                    <option value="R">R</option>
                </select>
                <span asp-validation-for="Rating" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Edited" class="form-label"></label>
                <select asp-for="Edited" class="form-select">
                    <option value="">Select an option</option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
                <span asp-validation-for="Edited" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LentTo" class="form-label"></label>
                <input asp-for="LentTo" class="form-control" placeholder="Optional" />
                <span asp-validation-for="LentTo" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Notes" class="form-label"></label>
                <input asp-for="Notes" class="form-control" maxlength="25" placeholder="Optional (max 25 characters)" />
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>

        </div>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <button type="submit" class="btn btn-primary px-4">Submit</button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>

    </form>
</div>
