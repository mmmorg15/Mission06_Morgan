@model Mission06_Morgan.Models.Movie


@* // Delete Confirmation Page *@
<h2 class="text-danger mb-3">Delete Movie</h2>

<div class="alert alert-warning">
    Are you sure you want to delete <strong>@Model.Title</strong> (@Model.Year)?
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" name="movieId" value="@Model.MovieId" />
    <button class="btn btn-danger" type="submit">Yes, Delete</button>
    <a class="btn btn-secondary" asp-action="MovieTable">Cancel</a>
</form>
